# Sublets Mobile · environment variables
# Copy this file to .env and fill in real values from your Supabase project.
# Supabase project: Settings → API → Project URL + API keys.
#
# The web app uses NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Expo uses the EXPO_PUBLIC_ prefix instead — same key value, different name.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
